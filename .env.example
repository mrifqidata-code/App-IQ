# ---------- Database (PostgreSQL) ----------
# Di Vercel: dua variabel ini terisi otomatis jika memakai Storage → Neon.
# Lokal: pakai Postgres lokal, atau salin dari Vercel dengan `npx vercel env pull .env`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindtest"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/mindtest"

# ---------- Auth ----------
# Secret untuk enkripsi session. Buat dengan: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-panjang"

# Google OAuth (lihat README bagian "Setup Login Google")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Login "Dev mode" tanpa Google. Otomatis aktif saat `npm run dev`.
# Di production SELALU nonaktif, kecuali di-set "true" secara eksplisit (tidak disarankan).
# AUTH_DEV_LOGIN="true"
